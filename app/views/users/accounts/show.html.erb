<% content_for :title, "Your account · Rails API Template" %>

<main class="auth-shell">
  <section class="card auth-card">
    <div class="card-body">
      <div class="auth-mark"><span class="auth-mark__icon">✦</span><span>Rails API Template</span></div>
      <span class="badge badge-success badge-outline">Signed in</span>
      <h2>Good to see you.</h2>
      <p class="auth-card__lead"><%= current_user.email %></p>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-outline auth-submit", data: { turbo: true } %>
    </div>
  </section>
</main>
