<% content_for :title, "Sign in · Rails API Template" %>

<main class="auth-shell">
  <div class="auth-layout">
    <aside class="auth-intro">
      <div class="auth-mark"><span class="auth-mark__icon">✦</span><span>Rails API Template</span></div>
      <h1>Build what matters next.</h1>
      <p>Sign in to keep your projects, settings, and ideas moving forward from one calm workspace.</p>
      <ul class="auth-points">
        <li>Simple account management</li>
        <li>Secure authentication by Devise</li>
        <li>Designed for focused work</li>
      </ul>
    </aside>

    <section class="card auth-card">
      <div class="card-body">
        <h2>Welcome back</h2>
        <p class="auth-card__lead">Sign in to continue to your account.</p>

        <%= render "devise/shared/error_messages", resource: resource %>
        <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "auth-form", data: { controller: "form", action: "turbo:submit-start->form#submitStart turbo:submit-end->form#submitEnd" } do |form| %>
          <div class="form-control">
            <%= form.label :email, class: "label" do %><span class="label-text">Email address</span><% end %>
            <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input input-md", placeholder: "you@example.com" %>
          </div>

          <div class="form-control" data-controller="password">
            <%= form.label :password, class: "label" do %><span class="label-text">Password</span><% end %>
            <div class="auth-password">
              <%= form.password_field :password, autocomplete: "current-password", required: true, class: "input input-md", data: { password_target: "input" } %>
              <button type="button" class="btn btn-ghost btn-xs" data-password-target="toggle" data-action="password#toggle" aria-pressed="false">Show</button>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <label class="label cursor-pointer justify-start gap-3">
              <%= form.check_box :remember_me, class: "checkbox checkbox-primary checkbox-sm" %>
              <span class="label-text">Remember me</span>
            </label>
          <% end %>

          <%= form.submit "Sign in", class: "btn btn-primary auth-submit", data: { form_target: "submit", loading_label: "Signing in…" } %>
        <% end %>

        <div class="divider auth-divider">or</div>
        <nav class="auth-links">
          <%= link_to "Create an account", new_registration_path(resource_name), class: "link link-primary", data: { turbo_frame: "user_authentication" } %>
          <%= link_to "Forgot password?", new_password_path(resource_name), class: "link link-primary", data: { turbo_frame: "_top" } %>
        </nav>
      </div>
    </section>
  </div>
</main>
