<% content_for :title, "Reset your password · Rails API Template" %>

<main class="auth-shell">
  <section class="card auth-card">
    <div class="card-body">
      <div class="auth-mark"><span class="auth-mark__icon">✦</span><span>Rails API Template</span></div>
      <h2>Reset your password</h2>
      <p class="auth-card__lead">Enter your email and we’ll send you a secure reset link.</p>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= form_with model: resource, as: resource_name, url: password_path(resource_name), class: "auth-form" do |form| %>
        <div class="form-control">
          <%= form.label :email, class: "label" do %><span class="label-text">Email address</span><% end %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input input-md", placeholder: "you@example.com" %>
        </div>
        <%= form.submit "Send reset link", class: "btn btn-primary auth-submit" %>
      <% end %>
      <p class="auth-links auth-links--center"><%= link_to "Back to sign in", new_session_path(resource_name), class: "link link-primary" %></p>
    </div>
  </section>
</main>
